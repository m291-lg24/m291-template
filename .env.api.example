# ------------------------------------------------------------------
# Konfiguration der PHP-API (Datenbank)
#   Lokal:   kopieren nach .env.api (Projektwurzel)
#   Plesk:   kopieren nach .env.api.production und per DEPLOY_API_ENV
#            nach /private/.env.api hochladen (ausserhalb von httpdocs)
# Diese Dateien werden NICHT committet.
# ------------------------------------------------------------------

# Fehlermeldungen im Klartext ausgeben (nur lokal true!)
APP_DEBUG=false

# Datenbank (Plesk → Datenbanken → Datenbank hinzufügen)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gruppe01_app
DB_USER=gruppe01_app
DB_PASS=bitte-ersetzen

# Nur nötig, wenn Frontend und API auf verschiedenen Domains laufen
# CORS_ORIGIN=https://app.example.ch
CORS_ORIGIN=
