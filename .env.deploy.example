# ------------------------------------------------------------------
# Zugangsdaten für "npm run deploy" (Plesk)
# Kopieren nach .env.deploy – diese Datei wird NICHT committet.
# Die Werte erhältst du von der Kursleitung (Zugangsdatenblatt).
# ------------------------------------------------------------------

DEPLOY_PROTOCOL=sftp

DEPLOY_HOST=palladius.sui-inter.net
DEPLOY_PORT=2121

# FTP-Benutzer der Subscription (Plesk → )
DEPLOY_USER=gruppe01
DEPLOY_PASSWORD="bitte-ersetzen"

# Nur SFTP: Pfad zu einem privaten Schlüssel statt Passwort
# DEPLOY_PRIVATE_KEY=~/.ssh/id_ed25519

# Zielordner relativ zur FTP-Wurzel der Subscription
#   Hauptdomain:   /httpdocs
#   Subdomain:     /app.example.ch
#   (Dokumentstamm laut Plesk-Hosting-Einstellungen)
# SFTP mit "chrooted" Shell: gleiche Pfade. Ohne chroot: absoluter Pfad,
#   z. B. /var/www/vhosts/example.ch/httpdocs
DEPLOY_REMOTE_DIR=/m291/httpdocs

# PHP-Backend: Inhalt von api/ mit hochladen (nur falls der Ordner existiert). true | false
DEPLOY_API=true
# Zielordner für api/. Standard: <DEPLOY_REMOTE_DIR>/api
# DEPLOY_API_DIR=/m291/httpdocs/api

# assets/ vor dem Upload leeren (entfernt alte Build-Dateien). true | false
DEPLOY_CLEAN=true

# Nur falls das Server-Zertifikat nicht zum Hostnamen passt
# (Notlösung, unsicher)
DEPLOY_FTPS_INSECURE=false
