# ------------------------------------------------------------------
# Frontend-Konfiguration (Vite)
# Kopieren nach .env.local (lokal) bzw. .env.production.local (Build).
# ACHTUNG: Alle VITE_-Variablen landen im ausgelieferten JavaScript.
#          Hier niemals Passwörter oder geheime Schlüssel eintragen!
# ------------------------------------------------------------------

# Titel der App (Navigation, Browser-Tab)
VITE_APP_TITLE="Mein M291-Projekt"

# Basis-URL der API. Standard: /api auf derselben Domain
VITE_API_BASE=/api

# Unterordner auf dem Server, falls die App nicht in der Domain-Wurzel liegt (z. B. /app/)
# Dann auch RewriteBase in public/.htaccess anpassen.
VITE_BASE_PATH=/

# Endpunkt für das Kontaktformular, z. B. https://formspree.io/f/xxxxxxx
# Leer lassen = Formular wird nur lokal validiert.
VITE_FORM_ENDPOINT=

# Nur lokal: Ziel für den /api-Proxy des Vite-Servers
DEV_API_TARGET=http://localhost:8000
